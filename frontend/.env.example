# ─── Brand ────────────────────────────────────────────────────────────────────
# Options: urformance | mu-jersey | kutee-club
VITE_BRAND=urformance

# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_API_KEY=your-api-key-here

# ─── Payment ──────────────────────────────────────────────────────────────────
# The PromptPay number to receive payments. If set, generates a dynamic QR code.
VITE_PROMPTPAY_NUMBER=id-or-phone-number
