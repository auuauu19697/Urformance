{
  "name": "orders-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Orders System monorepo — frontend (React+Vite) + backend (NestJS)",
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend run start:prod",
    "install:backend": "npm --prefix backend install",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
