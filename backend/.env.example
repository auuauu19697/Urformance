# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── Security ─────────────────────────────────────────────────────────────────
# Any string — clients must send this as: X-API-Key: <value>
API_KEY=your-secret-api-key-here

# ─── Google Sheets Service Account ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-spreadsheet-id

# ─── Google Sheets Tab Names ──────────────────────────────────────────────────
# Create these tabs in your spreadsheet manually
GOOGLE_ORDERS_SHEET=Orders
GOOGLE_ITEMS_SHEET=OrderItems
GOOGLE_WAITLIST_SHEET=Waitlist

# ─── Google Drive ─────────────────────────────────────────────────────────
# Create a folder in Drive, share it with the service account (Editor), paste the ID here
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-here
GOOGLE_DRIVE_OWNER_EMAIL=your.real.workspace.email@gmail.com

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

# ─── Email (Order Confirmation) ───────────────────────────────────────────────
# Use Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your.email@gmail.com

# ─── Brand ────────────────────────────────────────────────────────────────────
# Used in email subject and header
BRAND_NAME=URFORMANCE
