# ─── Google Sheets Service Account ───────────────────────────────────────────
# Get these from your GCP Console → IAM → Service Accounts → Create Key (JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key value (keep the \n line breaks, wrap in double quotes)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# The spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowed origins for CORS (your frontend URL)
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
